# FMKTools 工具百宝箱生产环境变量
# 复制为 .env 并按需修改后部署

# ========== 可选覆盖 ==========

# 文件转换接口每 IP 限流（slowapi 语法），空串关闭
TOOLBOX_RATE_LIMIT=20/minute

# 上传大小上限（MB），超出返回 413
TOOLBOX_MAX_UPLOAD_MB=100

# Swagger / ReDoc UI（生产保持 0）
TOOLBOX_DEBUG=0

# 公开密码分享页地址：二维码会编码为 <此地址>/share#密文；必须在前端构建期传入。
# 此值是公开网址，不含密码或密文。部署站点必须可从微信访问 HTTPS。
NEXT_PUBLIC_SHARE_BASE_URL=https://feimake.com/

# 上传接口 CORS 白名单：填写 Cloudflare Pages 的最终 HTTPS 域名
TOOLBOX_ALLOWED_ORIGINS=https://app.example.com

# 媒体任务限制
TOOLBOX_MEDIA_MAX_PENDING=4
TOOLBOX_MEDIA_JOB_TTL=1800
TOOLBOX_MEDIA_MAX_INPUT_MB=200
TOOLBOX_MEDIA_MAX_DOWNLOAD_MB=500
TOOLBOX_MEDIA_MAX_DURATION_SECONDS=7200

# LLM 配置与模型缓存持久化目录（Docker 挂载卷路径，保持默认即可）
TOOLBOX_DATA_DIR=/data
HF_HOME=/data/huggingface
DOCLING_CACHE=/data/docling
